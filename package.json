{
  "name": "dsh-godot-mcp-status",
  "version": "0.1.0",
  "description": "Godot MCP status badge for the DeepSeek Harness Web UI: the Godot logo with a blue/gray connection dot while the editor runs, drag-to-move, and endpoint detection with a copy-ready config row.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "godot",
    "mcp",
    "status",
    "badge",
    "overlay"
  ],
  "author": "oceanke100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanke100/dsh-godot-mcp-status.git"
  },
  "homepage": "https://github.com/oceanke100/dsh-godot-mcp-status#readme",
  "bugs": {
    "url": "https://github.com/oceanke100/dsh-godot-mcp-status/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "pack:dry": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "market": {
      "displayName": "Godot MCP status",
      "categories": [
        "ui",
        "dev"
      ]
    }
  }
}
